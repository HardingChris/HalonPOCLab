# Halon secrets - copy this file to secrets.env in the project root and fill in real values.
#
#   cp secrets.env.example secrets.env
#   nano secrets.env   # fill in real values
#
# Then deploy with:
#   bash deploy.sh

# ── msui (web admin interface) ───────────────────────────────────────────────

# MySQL password for the msui database user
MSUI_DB_PASSWORD="changeme"

# Admin user password (bcrypt hash - generate with: htpasswd -bnBC 12 "" mypassword | tr -d ':\n')
MSUI_ADMIN_PASSWORD='$2a$12$replacethiswithyourownbcrypthash'

# Elasticsearch credentials shared by msui and halon-web
ELASTIC_USERNAME="elastic"
ELASTIC_PASSWORD="changeme"

# ── smtpd ────────────────────────────────────────────────────────────────────
# Base64-encoded "username:password" for the Elasticsearch HTTP export header.
# Regenerate with: echo -n 'user:pass' | base64
SMTPD_ELASTIC_BASIC_AUTH="changeme"
# TLS private key for the web listener (PEM format).
# Replace this with your actual certificate private key.
WEB_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
...(your-private-key-content)...
-----END PRIVATE KEY-----"


# ── web (halon-web service) ───────────────────────────────────────────────────

# Admin user password (bcrypt hash - can match MSUI_ADMIN_PASSWORD if same user)
WEB_ADMIN_PASSWORD='$2a$12$replacethiswithyourownbcrypthash'

# Azure AD / OIDC client secret
WEB_OIDC_CLIENT_SECRET="replace-with-your-oidc-client-secret"

# (Elasticsearch credentials are shared — see ELASTIC_USERNAME / ELASTIC_PASSWORD above)

# ── api ──────────────────────────────────────────────────────────────────────
# Shared API secret used by api.yaml (authentication), web.yaml (host secret),
# and msui.yaml (MTA node apikey). All three must use the same value.
HALON_API_KEY="changeme"
